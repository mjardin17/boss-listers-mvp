{
  "manifest_version": 3,
  "name": "Boss Listers — Manual Listing Autofill",
  "version": "3.0.0",
  "description": "Pulls a Boss Listers manual listing package for a SKU and fills the matching fields on the marketplace's own listing form. Never submits/publishes for you — you review and click post yourself.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [
    "https://www.facebook.com/marketplace/create/*",
    "https://poshmark.com/create-listing*",
    "https://post.craigslist.org/*",
    "https://www.mercari.com/sell/*",
    "https://www.pinterest.com/pin/create/*",
    "https://www.pinterest.com/dashboard/*",
    "https://sellercentral.amazon.com/products/new*",
    "https://*.myshopify.com/*",
    "https://*wp-admin*",
    "https://www.abebooks.com/books/sell/*",
    "https://www.alibris.com/sell/*",
    "https://reverb.com/sells/*",
    "https://www.discogs.com/sell/*",
    "https://www.depop.com/*",
    "https://www.vinted.com/*",
    "https://www.grailed.com/sell*",
    "https://www.vestiairecollective.com/sell/*",
    "https://www.therealreal.com/sell*",
    "https://stockx.com/sell*",
    "https://www.goat.com/sell*",
    "https://*.myshopify.com/admin/products/*",
    "https://www.mercadolibre.com/*",
    "https://5miles.com/*",
    "https://seller.tiktok.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Boss Listers Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/marketplace/create/*",
        "https://poshmark.com/create-listing*",
        "https://post.craigslist.org/*",
        "https://www.mercari.com/sell/*",
        "https://www.pinterest.com/pin/create/*",
        "https://www.pinterest.com/dashboard/*",
        "https://sellercentral.amazon.com/products/new*",
        "https://*.myshopify.com/*",
        "https://*wp-admin*",
        "https://www.abebooks.com/books/sell/*",
        "https://www.alibris.com/sell/*",
        "https://reverb.com/sells/*",
        "https://www.discogs.com/sell/*",
        "https://www.depop.com/*",
        "https://www.vinted.com/*",
        "https://www.grailed.com/sell*",
        "https://www.vestiairecollective.com/sell/*",
        "https://www.therealreal.com/sell*",
        "https://stockx.com/sell*",
        "https://www.goat.com/sell*",
        "https://*.myshopify.com/admin/products/*",
        "https://www.mercadolibre.com/*",
        "https://5miles.com/*",
        "https://seller.tiktok.com/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
