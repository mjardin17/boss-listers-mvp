# ============================================================
# Marketplace Integration - Credential Slots
# Copy to .env and fill in ONLY the platforms you have access to.
# NEVER commit this file with real values.
# ============================================================

# ---------- eBay (✅ Open) ----------
EBAY_APP_ID=                      # Client ID
EBAY_CERT_ID=                     # Client Secret
EBAY_DEV_ID=                      # Developer ID (legacy)
EBAY_RU_NAME=                     # Your redirect URI name
EBAY_AUTH_TOKEN=                  # User auth token (OAuth2)
EBAY_SANDBOX=true                 # true while testing

# ---------- Etsy (✅ Open) ----------
ETSY_KEYSTRING=                   # API key keystring
ETSY_SHARED_SECRET=               # API key shared secret
ETSY_OAUTH_TOKEN=                 # user OAuth2 access token
ETSY_OAUTH_REFRESH=               # user OAuth2 refresh token
ETSY_SHOP_ID=                     # your numeric shop id

# ---------- Whatnot (⚠️ Waitlist) ----------
WHATNOT_API_KEY=
WHATNOT_GRAPHQL_URL=https://api.stage.whatnot.com/seller-api/graphql

# ---------- Depop (⚠️ Partner-gated) ----------
DEPOP_OAUTH_CLIENT_ID=
DEPOP_OAUTH_CLIENT_SECRET=
DEPOP_OAUTH_REFRESH_TOKEN=

# ---------- Mercari (⚠️ Partners only) ----------
MERCARI_ACCESS_TOKEN=

# ---------- Facebook Marketplace (⚠️ Approved partner) ----------
FB_ACCESS_TOKEN=
FB_BUSINESS_ID=
FB_CATALOG_ID=
