# Example env file for Boss Listers MVP

# Base URL of the app (used on frontend if needed)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Directory (under public/) where uploaded images are stored
UPLOADS_DIR=uploads

# Optional absolute directory for JSON history storage in production
DATA_DIR=

# Server-side OpenAI API key used for image recognition
OPENAI_API_KEY=

# Optional override for the vision-capable model
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional Supabase persistence/auth. When absent, the app falls back to local storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional product lookup adapters. Defaults to a safe mocked fallback when unset.
PRODUCT_LOOKUP_PROVIDER=mock
UPCITEMDB_API_KEY=
BARCODELOOKUP_API_KEY=
OPENFOODFACTS_ENABLED=false

# Optional market-data adapters. These are placeholders until official APIs are connected.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
AMAZON_ACCESS_KEY_ID=
WALMART_API_KEY=
TIKTOK_SHOP_API_KEY=
