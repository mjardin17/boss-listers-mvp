# Example env file for Boss Listers MVP
# Copy this file to .env.local and fill in real values

# ─────────────────────────────────────────────────────────────
# App Configuration
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Security: HTTP Basic Auth (required for all /api/* routes)
# ─────────────────────────────────────────────────────────────
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASS=changeme

# ─────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────
DATA_DIR=/var/data/store
UPLOAD_ROOT=/var/data/uploads

# ─────────────────────────────────────────────────────────────
# Rate Limiting (in-memory, single-instance only)
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
MAX_VISION_CALLS_PER_REQUEST=3

# ─────────────────────────────────────────────────────────────
# OpenAI (for image analysis)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# Supabase (shared inventory database)
# Server-side ONLY — never expose the service-role key to the browser
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://irslzufsqjveyibkfjtz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Platform Connectors (optional)
# ─────────────────────────────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_ENVIRONMENT=production

ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=
ETSY_REFRESH_TOKEN=

SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
