# Example env file for Boss Listers MVP
# Copy this file to .env.local and fill in real values

# ─────────────────────────────────────────────────────────────
# App Configuration
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Security: HTTP Basic Auth (legacy — superseded by Supabase Auth
# multi-tenant login below; kept only if some routes still use it)
# ─────────────────────────────────────────────────────────────
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASS=changeme

# ─────────────────────────────────────────────────────────────
# Supabase Auth (required for signup/login — pages/login.js)
#
# REQUIRED AT BUILD TIME, not just at Workers runtime. wrangler.toml's
# [vars] block only feeds the deployed Workers functions; it has NO
# effect on `next build`, which is what inlines these into the client
# bundle via next.config.js's `env` block. You MUST export these in
# the shell that runs `npm run build` / `npm run deploy` (or put them
# in .env.local for local builds) or every signup/login silently
# breaks — the build succeeds with no warning.
#
# The anon key is safe to expose client-side (RLS protects the data,
# not secrecy of this key). NEVER put SUPABASE_SERVICE_ROLE_KEY here
# or in any client-side (pages/*.js) file — that one stays Workers-only.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────
DATA_DIR=/var/data/store
UPLOAD_ROOT=/var/data/uploads

# ─────────────────────────────────────────────────────────────
# Rate Limiting (in-memory, single-instance only)
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
MAX_VISION_CALLS_PER_REQUEST=3

# ─────────────────────────────────────────────────────────────
# OpenAI (for image analysis)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional Supabase persistence/auth. When absent, the app falls back to local storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional product lookup adapters. Defaults to a safe mocked fallback when unset.
PRODUCT_LOOKUP_PROVIDER=mock
UPCITEMDB_API_KEY=
BARCODELOOKUP_API_KEY=
OPENFOODFACTS_ENABLED=false

# Optional market-data adapters. These are placeholders until official APIs are connected.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
AMAZON_ACCESS_KEY_ID=
WALMART_API_KEY=
TIKTOK_SHOP_API_KEY=
