# Social Media Posters - Environment Configuration
#
# This file documents all required environment variables for the social media
# posting adapters. Copy to .env and fill in your actual tokens.
#
# SECURITY: Never commit .env with real tokens to version control
# Use a secrets manager (AWS Secrets, HashiCorp Vault, etc.) in production

# ============================================================================
# INSTAGRAM REELS
# ============================================================================
# Get token: https://developers.facebook.com/docs/instagram-graph-api
# Required scopes: instagram_graph_business_publish_manage
# Permissions: Pages.Manage, Pages.Read.Engagement, Instagram.Manage
INSTAGRAM_TOKEN=your_instagram_business_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# ============================================================================
# TIKTOK
# ============================================================================
# Get token: https://developers.tiktok.com/
# Requires TikTok Creator or Business Account
# Required scopes: video.upload, video.publish
TIKTOK_TOKEN=your_tiktok_access_token_here
TIKTOK_REFRESH_TOKEN=your_tiktok_refresh_token_for_reauthentication

# ============================================================================
# YOUTUBE SHORTS
# ============================================================================
# Get token: https://console.developers.google.com/
# Required scopes: https://www.googleapis.com/auth/youtube.upload
# Note: Access token expires in ~1 hour, use refresh token to get new one
YOUTUBE_TOKEN=your_youtube_access_token_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_CLIENT_ID=your_google_client_id
YOUTUBE_CLIENT_SECRET=your_google_client_secret

# ============================================================================
# FACEBOOK
# ============================================================================
# Get token: https://developers.facebook.com/docs/facebook-login/access-tokens
# Required scopes: pages_manage_metadata, pages_read_engagement, video_library_manage
# Use PAGE access token, not USER access token
FACEBOOK_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_REFRESH_TOKEN=your_facebook_refresh_token_if_applicable

# ============================================================================
# TWITTER / X
# ============================================================================
# Get token: https://developer.twitter.com/en/portal/dashboard
# Authentication: OAuth 2.0 with Bearer token
# Required scopes: tweet.write, tweet.read
TWITTER_TOKEN=your_twitter_api_v2_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ============================================================================
# LINKEDIN
# ============================================================================
# Get token: https://www.linkedin.com/developers/apps
# Authentication: OAuth 2.0
# Required scopes: w_member_social, r_member_profile
LINKEDIN_TOKEN=your_linkedin_access_token_here
LINKEDIN_REFRESH_TOKEN=your_linkedin_refresh_token
LINKEDIN_PERSON_URN=urn:li:person:your_person_id
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your_org_id

# ============================================================================
# SNAPCHAT SPOTLIGHT
# ============================================================================
# Get token: https://businesshelp.snapchat.com/s/article/ads-manager-api
# Requires Snapchat Business Account and Spotlight approval
# Authentication: OAuth 2.0
SNAPCHAT_TOKEN=your_snapchat_access_token_here
SNAPCHAT_REFRESH_TOKEN=your_snapchat_refresh_token
SNAPCHAT_ORGANIZATION_ID=your_snapchat_organization_id

# ============================================================================
# PINTEREST
# ============================================================================
# Get token: https://developers.pinterest.com/
# Authentication: OAuth 2.0
# Required scopes: pins:create, pins:read, boards:read
PINTEREST_TOKEN=your_pinterest_access_token_here
PINTEREST_REFRESH_TOKEN=your_pinterest_refresh_token
PINTEREST_BOARD_ID=your_default_pinterest_board_id

# ============================================================================
# OPTIONAL: API RATE LIMITING CONFIGURATION
# ============================================================================
# These can override platform defaults if needed
RATE_LIMIT_INSTAGRAM_PER_HOUR=200
RATE_LIMIT_TIKTOK_PER_HOUR=50
RATE_LIMIT_YOUTUBE_PER_HOUR=100
RATE_LIMIT_FACEBOOK_PER_HOUR=200
RATE_LIMIT_TWITTER_PER_15MIN=300
RATE_LIMIT_LINKEDIN_PER_HOUR=100
RATE_LIMIT_SNAPCHAT_PER_HOUR=100
RATE_LIMIT_PINTEREST_PER_HOUR=100
RATE_LIMIT_PINTEREST_PER_DAY=15

# ============================================================================
# OPTIONAL: TIMEOUT CONFIGURATION (milliseconds)
# ============================================================================
# These can override platform defaults if network is slow
TIMEOUT_INSTAGRAM=30000
TIMEOUT_TIKTOK=60000
TIMEOUT_YOUTUBE=120000
TIMEOUT_FACEBOOK=30000
TIMEOUT_TWITTER=30000
TIMEOUT_LINKEDIN=60000
TIMEOUT_SNAPCHAT=30000
TIMEOUT_PINTEREST=30000

# ============================================================================
# OPTIONAL: RETRY CONFIGURATION
# ============================================================================
# Maximum number of retry attempts per upload
MAX_RETRIES_INSTAGRAM=3
MAX_RETRIES_TIKTOK=3
MAX_RETRIES_YOUTUBE=5
MAX_RETRIES_FACEBOOK=3
MAX_RETRIES_TWITTER=3
MAX_RETRIES_LINKEDIN=3
MAX_RETRIES_SNAPCHAT=3
MAX_RETRIES_PINTEREST=3

# ============================================================================
# OPTIONAL: MONITORING & LOGGING
# ============================================================================
# Enable debug logging
DEBUG_SOCIAL_POSTERS=false

# Webhook for posting results (optional)
WEBHOOK_POSTING_RESULTS=https://hooks.example.com/social-media-results

# Database connection for saving posted URLs
# DATABASE_URL=postgresql://user:password@localhost/social_media_db

# ============================================================================
# HOW TO GET TOKENS FOR EACH PLATFORM
# ============================================================================

# INSTAGRAM:
#   1. Go to https://developers.facebook.com/
#   2. Create an app and select "Business Type"
#   3. Add "Instagram Basic Display" and "Instagram Graph API" products
#   4. Generate access token in Settings > Basic Display
#   5. Use a long-lived token (60 days)
#
# TIKTOK:
#   1. Go to https://developers.tiktok.com/
#   2. Create a developer account (requires TikTok Creator/Business account)
#   3. Apply for Video API access
#   4. Create an app in "My Apps"
#   5. Get Client Credentials and request user authorization
#   6. Store both access token and refresh token
#
# YOUTUBE:
#   1. Go to https://console.developers.google.com/
#   2. Create a new project
#   3. Enable YouTube Data API v3
#   4. Create OAuth 2.0 credentials (Desktop App)
#   5. Install google-auth-oauthlib and run OAuth flow
#   6. Store access token and refresh token
#
# FACEBOOK:
#   1. Go to https://developers.facebook.com/
#   2. Create an app and select "Business" type
#   3. Add "Pages" product
#   4. Generate a Page Access Token with required scopes
#   5. Use the PAGE token, not the USER token
#
# TWITTER:
#   1. Go to https://developer.twitter.com/en/portal/dashboard
#   2. Apply for API access (requires approval)
#   3. Create a project and app
#   4. Generate API credentials (v2 API keys)
#   5. Get OAuth 2.0 credentials with user context grant flow
#
# LINKEDIN:
#   1. Go to https://www.linkedin.com/developers/apps
#   2. Create a new app
#   3. Request access to Sign In with LinkedIn scope
#   4. Implement OAuth 2.0 authorization code flow
#   5. Get person and organization URNs from profile
#
# SNAPCHAT:
#   1. Go to https://businesshelp.snapchat.com
#   2. Set up Snapchat Business Account
#   3. Request API access for Video Partners program
#   4. Once approved, implement OAuth 2.0 flow
#   5. Get organization ID from Settings
#
# PINTEREST:
#   1. Go to https://developers.pinterest.com/
#   2. Create an app in "My Apps"
#   3. Request OAuth 2.0 credentials
#   4. Implement OAuth 2.0 authorization code flow
#   5. Get board ID via API or from Pinterest web URL

